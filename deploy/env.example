# Arrival Atlas — Docker Compose environment template (personal staging).
#
# Copy to repository root as `.env` (never commit real secrets):
#   cp deploy/env.example .env
#
# Compose injects these into containers explicitly (API does not auto-load dotenv).

# --- Site / reverse proxy ----------------------------------------------------
# Local smoke (HTTP):
ATLAS_SITE_ADDRESS=http://localhost
ATLAS_PUBLIC_ORIGIN=http://localhost

# VPS with real domain + automatic HTTPS (Caddy):
# ATLAS_SITE_ADDRESS=atlas.example.com
# ATLAS_PUBLIC_ORIGIN=https://atlas.example.com

# Web image always builds with empty NEXT_PUBLIC_API_URL (same-origin /api via Caddy).
# Do not rely on a local-dev NEXT_PUBLIC_API_URL=http://localhost:3001 for Compose.

# --- Auth (required) ---------------------------------------------------------
# Generate a long random string. Do not use the built-in API default on a public host.
ARRIVAL_ATLAS_AUTH_SECRET=replace-with-long-random-secret

# Host-global Discovery ops (health + trigger-due-runs). Required; fail-closed if empty.
ARRIVAL_ATLAS_OPS_TOKEN=replace-with-long-random-ops-token

# --- Discovery providers (required for real Jobs runs) -----------------------
# Production default is Brave. Tavily is explicit opt-in only.
DISCOVERY_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
# DISCOVERY_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# --- Email (required for real notification delivery) -------------------------
RESEND_API_KEY=
DISCOVERY_EMAIL_FROM=Arrival Atlas <noreply@example.com>
# Optional single-tenant fallback when no personal notification email is saved:
# DISCOVERY_NOTIFICATION_EMAIL=
# Leave multi-user unset for personal staging (shared env fallback allowed):
# ARRIVAL_ATLAS_MULTI_USER=

# --- Optional Telegram -------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BASE_URL=

# --- Safety (Compose also hard-codes these on the API service) ---------------
# ARRIVAL_ATLAS_DEV_TOOLS=false
# Do not set DISCOVERY_USE_SMOKE_TRANSPORT=true in staging.
