# API
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database (future)
DATABASE_URL=postgresql://arrival-atlas:arrival-atlas@localhost:5432/arrival-atlas

# Redis (future)
# REDIS_URL=redis://localhost:6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Certainty Layer (E1) — off by default; set to "true" to enable inspector integration
NEXT_PUBLIC_CERTAINTY_LAYER_ENABLED=false

# Journey Guide consumes Certainty (E1 Phase 3) — off by default
NEXT_PUBLIC_GUIDE_USE_CERTAINTY=false

# Current Situation Resolver (E1 final) — off by default; no consumer wired yet
NEXT_PUBLIC_CURRENT_SITUATION_ENABLED=false

# Personal Discovery Engine — Brave Search (E3.2). Composition root only; never commit real keys.
# BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_BASE_URL=

# Personal Discovery Engine — temporary Tavily Search validation provider (E12.3a).
# Explicit opt-in only; Brave remains the production/default search provider.
# DISCOVERY_SEARCH_PROVIDER=brave
# DISCOVERY_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# TAVILY_SEARCH_BASE_URL=

# Personal Discovery Engine — OpenAI AiAdapter (E3.6). Composition root only; never commit real keys.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=

# Personal Discovery Engine — Resend email notifications (E4.5). Composition root only; never commit real keys.
# RESEND_API_KEY=
# DISCOVERY_EMAIL_FROM=Arrival Atlas <noreply@example.com>
# RESEND_BASE_URL=

# Personal Discovery Engine — optional single-tenant / personal Atlas notification fallback.
# Used only when the user has no personal notification email AND ARRIVAL_ATLAS_MULTI_USER is not enabled.
# Never exposed to clients. Disable shared fallback in multi-user deployments.
# DISCOVERY_NOTIFICATION_EMAIL=
# ARRIVAL_ATLAS_MULTI_USER=false

# Host-global Discovery ops (scheduler tick + runtime health). Required for:
#   GET  /api/ops/discovery/health
#   POST /api/ops/discovery/trigger-due-runs
# Present as: Authorization: Bearer <token>  OR  x-arrival-ops-token: <token>
# Fail-closed when unset. Never commit real values.
# ARRIVAL_ATLAS_OPS_TOKEN=

# Personal Discovery Engine — Telegram notifications (E4.6). Composition root only; never commit real keys.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BASE_URL=

# --- Docker Compose personal staging -----------------------------------------
# For reproducible container deployment, copy deploy/env.example to `.env` and
# see docs/deployment.md. Do not commit real secrets.
# ARRIVAL_ATLAS_AUTH_SECRET=
# ARRIVAL_ATLAS_OPS_TOKEN=
# ATLAS_SITE_ADDRESS=http://localhost
# ATLAS_PUBLIC_ORIGIN=http://localhost
