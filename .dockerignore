# Monorepo build context is the repository root (see docker-compose.yml).
# Keep images free of secrets, local state, and bulky artifacts.

.git
.github
.gitignore

**/node_modules
**/dist
**/.next
**/coverage
**/test-results
**/playwright-report
**/*.tsbuildinfo
README.pages

.env
.env.*
!.env.example
!deploy/env.example

.arrival-atlas-state
.arrival-atlas-accounts
.arrival-atlas-entitlements
.arrival-atlas-sessions
.arrival-atlas-state-*-test
apps/api/.arrival-atlas-state
apps/api/.arrival-atlas-accounts
apps/api/.arrival-atlas-entitlements
apps/api/.arrival-atlas-sessions
apps/api/.arrival-atlas-state-*-test

# Black-box probe evidence is not required to build web/api images.
# Dockerfiles only COPY package.json, lockfile, tsconfig.base.json, apps/, packages/, deploy/.
tools/black-box-audit/artifacts

**/*.log
**/.DS_Store
**/*.md
!docs/deployment.md
!README.md

docs/archive
docs/audits
docs/pr
docs/screenshots
docs/life-events/screenshots

**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/__tests__
apps/web/tests

agent-transcripts
.cursor
*.canvas.tsx
