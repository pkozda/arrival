{
  "name": "@arrival-atlas/modules",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./life-event": {
      "types": "./dist/life-event/index.d.ts",
      "import": "./dist/life-event/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@arrival-atlas/core": "*",
    "@arrival-atlas/product-contract": "*",
    "@arrival-atlas/module-sdk": "*",
    "@arrival-atlas/profile": "*",
    "@arrival-atlas/shared-services": "*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
